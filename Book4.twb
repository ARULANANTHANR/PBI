            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>Ford</run>
            <run fontalignment='0' fontname='Benton Sans Book'> comes in a close </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>second</run>
            <run fontalignment='0' fontname='Benton Sans Book'> place with </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>22,229</run>
            <run fontalignment='0' fontname='Benton Sans Book'> units. 🥈</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book'>🚘 </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>Toyota</run>
            <run fontalignment='0' fontname='Benton Sans Book'> sits comfortably in </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>third</run>
            <run fontalignment='0' fontname='Benton Sans Book'> place at </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>19,765</run>
            <run fontalignment='0' fontname='Benton Sans Book'> units. 🥉</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book'>🏎️ </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>BMW</run>
            <run fontalignment='0' fontname='Benton Sans Book'> holds a steady </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>fourth</run>
            <run fontalignment='0' fontname='Benton Sans Book'> position with </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>15,404</run>
            <run fontalignment='0' fontname='Benton Sans Book'> units. 📈</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book'>🏎️💨 </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>Porsche</run>
            <run fontalignment='0' fontname='Benton Sans Book'> has the </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>smallest</run>
            <run fontalignment='0' fontname='Benton Sans Book'> total engine size on the chart at </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>7,739</run>
            <run fontalignment='0' fontname='Benton Sans Book'> units. 📉</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book'>💡 </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>Color Code:</run>
            <run fontalignment='0' fontname='Benton Sans Book'> The bars use a </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>color gradient</run>
            <run fontalignment='0' fontname='Benton Sans Book'> 🎨 where </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>darker blue</run>
            <run fontalignment='0' fontname='Benton Sans Book'> represents the </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>largest</run>
            <run fontalignment='0' fontname='Benton Sans Book'> sizes and </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>light grey/white</run>
            <run fontalignment='0' fontname='Benton Sans Book'> represents the </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>smallest</run>
            <run fontalignment='0' fontname='Benton Sans Book'>! 🟦⬜</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book'>Would you like me to </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>calculate the average</run>
            <run fontalignment='0' fontname='Benton Sans Book'> engine size across these manufacturers, or do you need help </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>interpreting another chart</run>
            <run fontalignment='0' fontname='Benton Sans Book'>?</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book'>Æ&#10;</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
