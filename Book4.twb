        <zone flipboard-zone-id='5' forceUpdate='true' h='23963' hidden='true' id='12' story-point-id='17' type-v2='text' w='69882' x='29921' y='27593'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>This image is a stacked bar chart</run>
            <run fontalignment='0' fontname='Benton Sans Book'> displaying the distribution of vehicle counts by fuel type (</run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book'>Petrol, Diesel, and Hybrid</run>
            <run fontalignment='0' fontname='Benton Sans Book'>) across different categories, though the horizontal labels at the bottom are cut off.📊</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='22095' hidden='true' id='13' story-point-id='19' type-v2='text' w='35630' x='295' y='15249'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>Petrol</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> accounts for roughly </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>51%</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> of the data. The red slice correctly reflects this by taking up slightly over half of the circle.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'>🔵 </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>Diesel</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> accounts for roughly </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>26.5%</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> of the data.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'>🟠 </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>Hybrid</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> accounts for roughly </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>22.5%</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> of the data.</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='28320' hidden='true' id='14' story-point-id='20' type-v2='text' w='59252' x='40354' y='16598'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>📊 Histogram Structure</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'>📈 </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>Vertical Y-Axis:</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> Labeled ➡️ </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>Count of Engine size</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'>, ranging from </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>0 to 22K (22,000)</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'>. It accurately represents the number of vehicles.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'>📉 </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>Horizontal X-Axis:</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'> Represents the </run>
            <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='10'>Engine Size bins</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='10'>. The decimal numbers on top of each bar indicate the central value or starting threshold for each engine size category (measured in liters).</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='44191' hidden='true' id='15' story-point-id='23' type-v2='text' w='60039' x='37992' y='27593'>
